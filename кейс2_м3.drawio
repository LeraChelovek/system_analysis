        <mxCell id="cOkY35Mf-GIuzJV4pXS--23" value="Управление жизненным циклом" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#99ffff;shape=mxgraph.archimate3.service;" parent="1" vertex="1">
