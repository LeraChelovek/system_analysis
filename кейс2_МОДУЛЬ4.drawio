        <mxCell id="chl4N1V4sNgDopftral5-143" value="" style="edgeStyle=elbowEdgeStyle;html=1;endArrow=open;elbow=vertical;endFill=1;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="chl4N1V4sNgDopftral5-141" target="chl4N1V4sNgDopftral5-102" edge="1">
